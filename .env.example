# memory | redis. Local default is the in-process memory store (R-07.2).
STORE_DRIVER=memory

# Upstash Redis REST endpoint. Empty while STORE_DRIVER=memory.
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token. Empty while STORE_DRIVER=memory.
UPSTASH_REDIS_REST_TOKEN=

# Sliding session TTL in seconds. R-02.3: 15 minutes.
SESSION_TTL_SECONDS=900

# Handoff token TTL in seconds. R-02.3: 10 minutes.
HANDOFF_TTL_SECONDS=600

# Probability from 0 to 1 that a mock verification call fails. 0 keeps the happy path deterministic (spec 03).
MOCK_FAILURE_RATE=0

# Demo banner and noindex. Default true in every environment (R-07.7). Banner and headers are P5.
DEMO_MODE=true
